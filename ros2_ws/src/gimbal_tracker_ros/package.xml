<?xml version="1.0"?>
<package format="3">
  <name>gimbal_tracker_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble nodes for the simulated two-axis gimbal tracker.</description>
  <maintainer email="dev@example.com">gimbal-tracker maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>gimbal_tracker_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
